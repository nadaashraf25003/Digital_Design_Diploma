set_driving_cell -lib_cell BUFX2M -library scmetro_tsmc_cl013g_rvt_ss_1p08v_125c -pin Y [get_ports {ALU_B[0]}]
set_load -pin_load 50 [get_ports ALU_VLD]
set_load -pin_load 50 [get_ports {ALU_OUT[15]}]
set_load -pin_load 50 [get_ports {ALU_OUT[14]}]
set_load -pin_load 50 [get_ports {ALU_OUT[13]}]
