set_load -pin_load 50 [get_ports {ALU_OUT[0]}]
create_clock [get_ports CLK]  -name MASTER_CLK  -period 50  -waveform {0 25}
set_clock_latency 0  [get_clocks MASTER_CLK]
set_clock_uncertainty -setup 0.2  [get_clocks MASTER_CLK]
set_clock_uncertainty -hold 0.1  [get_clocks MASTER_CLK]
set_clock_transition -max -rise 0.05 [get_clocks MASTER_CLK]
set_clock_transition -min -rise 0.05 [get_clocks MASTER_CLK]
set_clock_transition -max -fall 0.05 [get_clocks MASTER_CLK]
set_clock_transition -min -fall 0.05 [get_clocks MASTER_CLK]
create_generated_clock [get_pins U0_ClkDiv/o_div_clk]  -name ALU_CLK  -source [get_ports CLK]  -master_clock MASTER_CLK  -divide_by 2  -add
set_clock_uncertainty -setup 0.2  [get_clocks ALU_CLK]
set_clock_uncertainty -hold 0.1  [get_clocks ALU_CLK]
group_path -name INOUT  -from [list [get_ports CLK] [get_ports RST] [get_ports ALU_Enable] [get_ports {ALU_FUN[3]}] [get_ports {ALU_FUN[2]}] [get_ports {ALU_FUN[1]}] [get_ports {ALU_FUN[0]}] [get_ports {ALU_A[7]}] [get_ports {ALU_A[6]}] [get_ports {ALU_A[5]}] [get_ports {ALU_A[4]}] [get_ports {ALU_A[3]}] [get_ports {ALU_A[2]}] [get_ports {ALU_A[1]}] [get_ports {ALU_A[0]}] [get_ports {ALU_B[7]}] [get_ports {ALU_B[6]}] [get_ports {ALU_B[5]}] [get_ports {ALU_B[4]}] [get_ports {ALU_B[3]}] [get_ports {ALU_B[2]}] [get_ports {ALU_B[1]}] [get_ports {ALU_B[0]}]]  -to [list [get_ports ALU_VLD] [get_ports {ALU_OUT[15]}] [get_ports {ALU_OUT[14]}] [get_ports {ALU_OUT[13]}] [get_ports {ALU_OUT[12]}] [get_ports {ALU_OUT[11]}] [get_ports {ALU_OUT[10]}] [get_ports {ALU_OUT[9]}] [get_ports {ALU_OUT[8]}] [get_ports {ALU_OUT[7]}] [get_ports {ALU_OUT[6]}] [get_ports {ALU_OUT[5]}] [get_ports {ALU_OUT[4]}] [get_ports {ALU_OUT[3]}] [get_ports {ALU_OUT[2]}] [get_ports {ALU_OUT[1]}] [get_ports {ALU_OUT[0]}]]
group_path -name INREG  -from [list [get_ports CLK] [get_ports RST] [get_ports ALU_Enable] [get_ports {ALU_FUN[3]}] [get_ports {ALU_FUN[2]}] [get_ports {ALU_FUN[1]}] [get_ports {ALU_FUN[0]}] [get_ports {ALU_A[7]}] [get_ports {ALU_A[6]}] [get_ports {ALU_A[5]}] [get_ports {ALU_A[4]}] [get_ports {ALU_A[3]}] [get_ports {ALU_A[2]}] [get_ports {ALU_A[1]}] [get_ports {ALU_A[0]}] [get_ports {ALU_B[7]}] [get_ports {ALU_B[6]}] [get_ports {ALU_B[5]}] [get_ports {ALU_B[4]}] [get_ports {ALU_B[3]}] [get_ports {ALU_B[2]}] [get_ports {ALU_B[1]}] [get_ports {ALU_B[0]}]]
group_path -name REGOUT  -to [list [get_ports ALU_VLD] [get_ports {ALU_OUT[15]}] [get_ports {ALU_OUT[14]}] [get_ports {ALU_OUT[13]}] [get_ports {ALU_OUT[12]}] [get_ports {ALU_OUT[11]}] [get_ports {ALU_OUT[10]}] [get_ports {ALU_OUT[9]}] [get_ports {ALU_OUT[8]}] [get_ports {ALU_OUT[7]}] [get_ports {ALU_OUT[6]}] [get_ports {ALU_OUT[5]}] [get_ports {ALU_OUT[4]}] [get_ports {ALU_OUT[3]}] [get_ports {ALU_OUT[2]}] [get_ports {ALU_OUT[1]}] [get_ports {ALU_OUT[0]}]]
